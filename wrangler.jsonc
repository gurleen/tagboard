{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tagboard",
	// Written by `@sveltejs/adapter-cloudflare` during `vite build`.
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	// `AsyncLocalStorage`, which `getRequestEvent()` needs in order to find the
	// bindings after an `await`. See `src/lib/server/environment.ts`.
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DATABASE",
			"database_name": "tagboard",
			// No `database_id`: `wrangler deploy` provisions the database by name on
			// first deploy, and local development does not need one.
			// Migrations are generated by drizzle-kit; see `drizzle.config.ts`.
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "tagboard-media"
		}
	]
}
